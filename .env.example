# Copie para .env.local em desenvolvimento.
# Em produção, configure estas mesmas chaves em:
# Vercel → Project → Settings → Environment Variables

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# URL pública do site (usada em redirects de auth, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# Mercado Pago (Suas integrações → Credenciais de produção)
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# Mercado Pago OAuth (Suas integrações → sua aplicação → OAuth)
# Necessário para o split de pagamento: cada vendedor conecta sua própria
# conta MP em /vendedor/mercadopago/conectar
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
